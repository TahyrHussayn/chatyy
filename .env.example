# -----------------------------------------------------------------------------
# Chatyy Environment Variables Template
# Copy this file to `.env.local` to override settings locally.
# -----------------------------------------------------------------------------

# [Security] Secret stealth unlock password (server-side only, 100% private)
CHAT_PASSWORD=

# [App URL] Optional custom public domain (used for SEO & social preview cards)
# e.g., NEXT_PUBLIC_APP_URL=https://your-domain.com
NEXT_PUBLIC_APP_URL=

# [Vercel KV / Upstash Redis] (Optional for local dev, auto-injected on Vercel)
# When you link a KV database in the Vercel Dashboard, these are set automatically.
KV_URL=
KV_REST_API_URL=
KV_REST_API_TOKEN=
KV_REST_API_READ_ONLY_TOKEN=
